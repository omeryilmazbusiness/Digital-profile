# Copy to .env for local development (`make setup` does this for you).
# Values here are for local development only. Never reuse them in staging or production.
# Keep comments on their own line: trailing comments become part of the value in some loaders.

# --- Backend API -------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_BODY_BYTES=1048576
# CIDRs of reverse proxies whose X-Forwarded-For is trusted for the client IP.
HTTP_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# debug | info | warn | error
LOG_LEVEL=debug
# json | text
LOG_FORMAT=text

# Browser origins allowed to call the API cross-origin (comma separated, https only in production).
# Leave empty when the frontend is served from the same origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public origin of the admin UI. State-changing auth/admin requests must come from it or from
# CORS_ALLOWED_ORIGINS (CSRF origin check). https only in production.
APP_PUBLIC_ORIGIN=http://localhost:3000

# --- Authentication ------------------------------------------------------------
# HS256 key ring: comma-separated "kid:base64(>=32 random bytes)". The first key signs; the
# others only verify, so rotate by prepending a new key and removing the old one after
# AUTH_ACCESS_TTL. Generate keys with `make jwt-key`. NEVER reuse this development key.
AUTH_JWT_KEYS=dev:ZGV2LW9ubHktand0LWtleS1kby1ub3QtdXNlLWFueXdoZXJlIQ==
AUTH_JWT_ISSUER=digital-profile-api
AUTH_JWT_AUDIENCE=digital-profile-admin
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=168h
# Absolute session lifetime; refreshing never extends a session beyond it.
AUTH_SESSION_MAX_AGE=720h
# A rotated refresh token presented again within this window is treated as a concurrent
# request (409); after it, as theft (every session is revoked).
AUTH_REFRESH_REUSE_GRACE=10s
# Plain-HTTP local development needs false; production refuses false.
AUTH_COOKIE_SECURE=false
# After THRESHOLD consecutive failures the account locks for BASE, doubling per further
# failure up to MAX.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_BASE=1m
AUTH_LOCKOUT_MAX=1h

# Per-client-IP token buckets. The strict policy applies to login and public form endpoints.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_STRICT_RPS=0.2
RATE_LIMIT_STRICT_BURST=5
RATE_LIMIT_IDLE_TTL=10m

# --- PostgreSQL (deploy/docker-compose.dev.yml) -------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app-dev-password
POSTGRES_DB=digital_profile
POSTGRES_PORT=5432

# Connection used by the API and CLI; must match the POSTGRES_* values above.
DATABASE_URL=postgres://app:app-dev-password@localhost:5432/digital_profile?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
# Development convenience: apply migrations on startup. Keep false in production.
DATABASE_AUTO_MIGRATE=true

# --- Media -------------------------------------------------------------------
# Upload cap for one image (1-100 MiB) and decoded size cap (decompression-bomb guard).
MEDIA_MAX_UPLOAD_BYTES=20971520
MEDIA_MAX_PIXELS=50000000
# Images rendered at once; each 12 MP photo needs ~300 MB while processing.
MEDIA_PROCESSING_CONCURRENCY=1
MEDIA_WEBP_QUALITY=82
# CDN origin prefixed to variant URLs; empty serves them from the API origin.
MEDIA_PUBLIC_BASE_URL=

# --- Documents ---------------------------------------------------------------
# Upload cap for one PDF of the Discover section (1-100 MiB).
DOCUMENTS_MAX_UPLOAD_BYTES=26214400

# Where media files live: "local" (a directory), "s3" (any S3-compatible service) or
# "postgres" (the application database; for hosts without a persistent disk). On Railway,
# "local" is refused unless the directory is on an attached volume.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage

# --- S3-compatible object storage (RustFS) -----------------------------------
# Used when STORAGE_DRIVER=s3. The bucket must exist.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_ACCESS_KEY=rustfs-dev
S3_SECRET_KEY=rustfs-dev-secret
S3_BUCKET=digital-profile
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Mail catcher (Mailpit) --------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
