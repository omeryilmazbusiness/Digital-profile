# Copy to .env for local development (`make setup` does this for you).
# Values here are for local development only. Never reuse them in staging or production.
# Keep comments on their own line: trailing comments become part of the value in some loaders.

# --- Backend API -------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_BODY_BYTES=1048576
# CIDRs of reverse proxies whose X-Forwarded-For is trusted for the client IP.
HTTP_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# debug | info | warn | error
LOG_LEVEL=debug
# json | text
LOG_FORMAT=text

# Browser origins allowed to call the API cross-origin (comma separated, https only in production).
# Leave empty when the frontend is served from the same origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Per-client-IP token buckets. The strict policy applies to login and public form endpoints.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_STRICT_RPS=0.2
RATE_LIMIT_STRICT_BURST=5
RATE_LIMIT_IDLE_TTL=10m

# --- PostgreSQL (deploy/docker-compose.dev.yml) -------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app-dev-password
POSTGRES_DB=digital_profile
POSTGRES_PORT=5432

# Connection used by the API and CLI; must match the POSTGRES_* values above.
DATABASE_URL=postgres://app:app-dev-password@localhost:5432/digital_profile?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
# Development convenience: apply migrations on startup. Keep false in production.
DATABASE_AUTO_MIGRATE=true

# --- S3-compatible object storage (RustFS) -----------------------------------
S3_ACCESS_KEY=rustfs-dev
S3_SECRET_KEY=rustfs-dev-secret
S3_BUCKET=digital-profile
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Mail catcher (Mailpit) --------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
