# Copy to .env.local for local development. NEXT_PUBLIC_* values are inlined at build time.

# Where the Next server reaches the API. The site forwards /api/v1/* there, so the admin panel
# and the API share an origin. Needed at build time (the forwarding is fixed then) and at runtime.
API_URL=http://localhost:8080

# API origin for the browser, only when the API is served from another origin than the site.
# Leave empty when API_URL is set.
NEXT_PUBLIC_API_URL=

# Set to true to keep the /design component gallery in a production build.
DESIGN_GALLERY=false

# Public origin of the site, e.g. https://sheraton-makkah.example. Used for sharing metadata
# and the link on the downloadable contact card; both are left out when empty.
NEXT_PUBLIC_SITE_URL=
