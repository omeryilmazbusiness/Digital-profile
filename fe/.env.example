# Copy to .env.local for local development. NEXT_PUBLIC_* values are inlined at build time.

# API origin, only when the API is served from another origin than the site
# (local development: the API runs on :8080). Leave empty behind a same-origin proxy.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Set to true to keep the /design component gallery in a production build.
DESIGN_GALLERY=false
